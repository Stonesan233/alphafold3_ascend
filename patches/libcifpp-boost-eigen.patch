diff --git a/CMakeLists.txt b/CMakeLists.txt
index 0eda58d..49cd23f 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -172,7 +172,7 @@ if(GXX_LIBSTDCPP)
 			"You are probably trying to compile using the g++ standard library which contains a crashing std::regex implementation. Will use boost::regex instead"
 		)
 
-		find_package(Boost 1.80 QUIET COMPONENTS regex)
+		find_package(Boost 1.74 QUIET COMPONENTS regex)
 
 		if(NOT Boost_FOUND)
 			set(BOOST_REGEX_STANDALONE ON)
@@ -232,11 +232,23 @@ if(Eigen3_FOUND AND TARGET Eigen3::Eigen)
 	get_target_property(EIGEN_INCLUDE_DIR Eigen3::Eigen
 		INTERFACE_INCLUDE_DIRECTORIES)
 else()
-	# Create a private copy of eigen3 and populate it only, no need to build
-	FetchContent_Declare(
-		my-eigen3
-		GIT_REPOSITORY https://gitlab.com/libeigen/eigen.git
-		GIT_TAG 3.4.0)
+	# Offline builds: prefer a pre-downloaded eigen source tree next to the
+	# other dependencies (DEPS_DIR is set by the parent alphafold3 project,
+	# or take ALPHAFOLD3_DEPS_DIR from the environment when standalone).
+	if(NOT DEFINED DEPS_DIR OR DEPS_DIR STREQUAL "")
+		set(DEPS_DIR "$ENV{ALPHAFOLD3_DEPS_DIR}")
+	endif()
+
+	if(DEPS_DIR AND EXISTS "${DEPS_DIR}/eigen")
+		FetchContent_Declare(
+			my-eigen3
+			SOURCE_DIR "${DEPS_DIR}/eigen")
+	else()
+		FetchContent_Declare(
+			my-eigen3
+			GIT_REPOSITORY https://gitlab.com/libeigen/eigen.git
+			GIT_TAG 3.4.0)
+	endif()
 
 	FetchContent_GetProperties(my-eigen3)
 
@@ -244,7 +256,10 @@ else()
 		FetchContent_Populate(my-eigen3)
 	endif()
 
-	set(EIGEN_INCLUDE_DIR ${my-eigen3_SOURCE_DIR})
+	# Eigen module headers (e.g. Eigen/Eigenvalues) do `#include "Core"`,
+	# resolved relative to the Eigen/ directory itself, so both the eigen
+	# root and Eigen/ must be on the include path (semicolon-separated list).
+	set(EIGEN_INCLUDE_DIR "${my-eigen3_SOURCE_DIR};${my-eigen3_SOURCE_DIR}/Eigen")
 endif()
 
 include(FindFilesystem)
